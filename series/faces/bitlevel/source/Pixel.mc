import Toybox.Graphics;
import Toybox.Lang;

// 3x5 pixel font for Bitlevel. Generated by series/tools/pixelfont.py.
module Pixel {
    const CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ:%-/. ";
    const BITS = [31599, 11415, 29671, 29647, 23497, 31183, 31215, 29266, 31727, 31695, 11245, 27566, 14627, 27502, 31143, 31140, 14699, 23533, 29847, 4714, 23469, 18727, 24557, 27501, 11114, 27556, 11123, 27565, 14478, 29842, 23407, 23402, 23549, 23213, 23186, 29351, 1040, 21157, 448, 4772, 2, 0];

    // Width in pixels of text drawn with block size p (3 blocks per glyph, 1 block gap).
    function width(text as String, p as Number) as Number {
        var n = text.length();
        return (n <= 0) ? 0 : n * 4 * p - p;
    }

    // Draws text centered on x, top at y, with square blocks of p pixels.
    function draw(dc as Dc, x as Number, y as Number, text as String, p as Number) as Void {
        var cx = x - width(text, p) / 2;
        var up = text.toUpper();
        for (var i = 0; i < up.length(); i++) {
            var idx = CHARS.find(up.substring(i, i + 1) as String);
            if (idx != null) {
                glyph(dc, cx, y, BITS[idx] as Number, p);
            }
            cx += 4 * p;
        }
    }

    function glyph(dc as Dc, x as Number, y as Number, bits as Number, p as Number) as Void {
        for (var row = 0; row < 5; row++) {
            for (var col = 0; col < 3; col++) {
                if (((bits >> (14 - row * 3 - col)) & 1) == 1) {
                    dc.fillRectangle(x + col * p, y + row * p, p, p);
                }
            }
        }
    }

    // 7x6 heart; full or empty (outline color comes from the caller).
    const HEART = [54, 127, 127, 62, 28, 8];

    function heart(dc as Dc, x as Number, y as Number, p as Number) as Void {
        for (var row = 0; row < 6; row++) {
            var bits = HEART[row] as Number;
            for (var col = 0; col < 7; col++) {
                if (((bits >> (6 - col)) & 1) == 1) {
                    dc.fillRectangle(x + col * p, y + row * p, p, p);
                }
            }
        }
    }
}
